# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# The key is read once, at process start, by python-dotenv.

OPENAI_API_KEY=sk-proj-replace-me

# Optional. Hard ceiling in USD for a single `personareact run` invocation.
# The runner stops and writes a partial manifest when the estimate is exceeded.
PERSONAREACT_COST_LIMIT_USD=25.0
